{
  "name": "dvi-backend-starter",
  "version": "1.0.0",
  "description": "DVI Backend Starter - NestJS + Prisma (MySQL) with Hotels & Itineraries modules and RBAC",
  "main": "dist/src/main.js",
  "scripts": {
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "test:payments": "tsx --test test/payments/*.test.ts",
    "test:cross-day-optimizer": "tsx test/same-city-cross-day-optimizer.test.ts",
    "test:vehicle-agent-policy": "tsx --test test/vehicle-agent-policy.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "seed": "ts-node prisma/seed.ts",
    "seed:vehicle-agent": "tsx scripts/seed-vehicle-agent.ts",
    "seed:ooty-ghat": "tsx scripts/seed-ooty-ghat-geofence.ts",
    "seed:vendor:php": "node scripts/seed-vendor-from-php.js",
    "sync:hotel-rates": "node scripts/sync-hotel-rates-between-databases.js",
    "seed:hotel-rateplans": "tsx scripts/sync-hotel-rate-plan-master.ts",
    "backfill:hotel-rateplans": "tsx scripts/backfill-hotel-room-rate-plans.ts",
    "axisrooms:backfill-property-ids": "node backfill-axisrooms-property-ids.js",
    "seed:justa": "node scripts/import-justa-hotels.js",
    "seed:staah:test": "ts-node seed-staah-test-data.ts",
    "cert:tbo": "tsx verification-e2e/tbo-certification/run-tbo-certification.ts",
    "verify:hotspot-parity": "tsx verification-e2e/hotspot-engine-parity/run-hotspot-engine-parity.ts",
    "verify:vehicle-build": "node scripts/verify-itinerary-vehicle-build.js",
    "test:api": "node scripts/test-api-endpoints.js",
    "test:api:all": "set RUN_FULL_SWEEP=true&& node scripts/test-api-endpoints.js",
    "test:swagger": "node scripts/check-swagger-coverage.js",
    "openapi:generate": "ts-node -r tsconfig-paths/register scripts/generate-openapi.ts",
    "openapi:compare": "tsx scripts/compare-openapi.ts",
    "audit:database": "tsx scripts/audit-database-performance.ts",
    "tbo:live:probe": "node scripts/tbo-live-prod-probe.js",
    "verify:hotel-rateplans": "tsx scripts/verify-hotel-rate-plan-system.ts",
    "verify:hotel-pricebook-range": "tsx scripts/verify-hotel-pricebook-range-view.ts",
    "fix:axisrooms-roomtypes": "tsx scripts/fix-axisrooms-roomtype-mismatches.ts",
    "backfill:locations:self-route": "tsx scripts/backfill-location-self-routes.ts",
    "backfill:locations:self-route:apply": "tsx scripts/backfill-location-self-routes.ts --apply",
    "backfill:stored-location-city-ids": "tsx scripts/backfill-stored-location-city-ids.ts",
    "backfill:stored-location-city-ids:apply": "tsx scripts/backfill-stored-location-city-ids.ts --apply",
    "backfill:meal-plan-code": "node scripts/backfill-meal-plan-code.js",
    "backfill:meal-plan-code:apply": "node scripts/backfill-meal-plan-code.js --apply",
    "backfill:stored-location-osrm": "tsx scripts/backfill-stored-location-osrm.ts",
    "backfill:stored-location-osrm:apply": "tsx scripts/backfill-stored-location-osrm.ts --apply",
    "rollback:stored-location-osrm": "tsx scripts/rollback-stored-location-osrm.ts",
    "rollback:stored-location-osrm:apply": "tsx scripts/rollback-stored-location-osrm.ts --apply",
    "test:stored-location-osrm": "tsx --test test/stored-location-osrm-backfill.test.ts",
    "build:hotspot-matrix": "tsx scripts/build-hotspot-route-matrix.ts",
    "build:hotspot-matrix:apply": "tsx scripts/build-hotspot-route-matrix.ts --apply",
    "build:hotspot-matrix:retry": "tsx scripts/build-hotspot-route-matrix.ts --apply --retry-failed",
    "verify:hotspot:between": "node scripts/verify-hotspot-between-cheeyappara-eravikulam.js",
    "verify:hotspot:not-between": "node scripts/verify-hotspot-not-between-eravikulam-rosegarden.js",
    "verify:day1:airport-munnar-via": "node scripts/verify-day1-airport-munnar-via.js",
    "verify:dvi20260690:direct-no-via": "node scripts/verify-dvi20260690-direct-no-via.js",
    "verify:dvi20260690:explicit-via": "node scripts/verify-dvi20260690-explicit-via.js",
    "verify:suggested-route-family-parity": "node scripts/verify-suggested-route-family-parity.js",
    "verify:legacy-route-options-16": "node scripts/verify-legacy-route-options-16.js",
    "analyze:itinerary:hotspots": "tsx scripts/analyze-itinerary-hotspot-scenarios.ts",
    "debug:fit-preview": "tsx scripts/debug-fit-preview-source.ts",
    "debug:fit-preview:apj": "tsx scripts/check-fit-preview-apj-op-time.ts",
    "debug:fit-confirm": "tsx scripts/debug-fit-confirm.ts",
    "debug:fit-confirm:rescue": "tsx scripts/debug-fit-confirm-rescue.ts",
    "debug:fit-here:replay": "tsx scripts/debug-fit-here-preview-confirm-replay.ts",
    "debug:cross-day": "tsx scripts/debug-same-city-cross-day-allocation.ts",
    "verify:manual-fit:sweep": "tsx scripts/verify-manual-fit-here-sweep.ts",
    "verify:manual-fit:sweep:confirm": "tsx scripts/verify-manual-fit-here-sweep.ts --confirm=true",
    "test:matrix": "tsx scripts/test-matrix-autobuild.ts",
    "test:available-hotspots-anchor": "tsx scripts/test-available-hotspots-anchor.local.ts",
    "sync:tbo:missing-city": "node scripts/sync-missing-tbo-hotels-by-city.js",
    "sync:tbo:missing-city:dry": "node scripts/sync-missing-tbo-hotels-by-city.js --dry-run",
    "cleanup:vendor-outstation-duplicates": "tsx scripts/cleanup-vendor-outstation-duplicates.ts",
    "postinstall": "npx playwright install chromium"
  },
  "dependencies": {
    "@apollo/server": "^4.13.0",
    "@nestjs/apollo": "^12.2.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^10.3.2",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.3.2",
    "@nestjs/graphql": "^12.2.2",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.2",
    "@nestjs/swagger": "^7.3.0",
    "@prisma/client": "^5.20.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "^0.17.6",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "form-data": "^4.0.5",
    "graphql": "^16.13.2",
    "mysql2": "^3.15.3",
    "nodemailer": "^8.0.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.27",
    "@types/passport-jwt": "^4.0.1",
    "playwright": "^1.60.0",
    "prisma": "^5.20.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5"
  }
}
